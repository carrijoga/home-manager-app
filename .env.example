# Modo de dados: 'mock' para dados locais, 'api' para API externa
VITE_DATA_MODE=mock

# URL da API (quando implementar o backend)
VITE_API_URL=http://localhost:3001/api

# URL da API ASP.NET responsavel pelos endpoints de autenticação
VITE_AUTH_API_URL=https://localhost:7067
# Para cookies HttpOnly funcionarem, garanta que o backend aceite credentials e configure o CORS adequadamente.

# Configurações do Google OAuth 2.0 (para login com Google)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Obtenha seu Client ID em: https://console.cloud.google.com/apis/credentials

