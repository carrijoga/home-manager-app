# Modo de dados: 'mock' para dados locais, 'api' para API externa
VITE_DATA_MODE=mock

# Ambiente: 'development', 'staging', ou 'production'
VITE_ENVIRONMENT=development

# URLs da API para cada ambiente
VITE_API_URL=http://localhost:3001/
VITE_API_STAGING_URL=https://staging-api.ninho.app/
VITE_API_PRODUCTION_URL=https://api.ninho.app/

# Autenticação Google
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback